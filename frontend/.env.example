# Base URL of the CropGuard API, including scheme, without a trailing slash.
#
# Local development:
#   VITE_API_BASE_URL=http://localhost:8000
#
# Deployed backend (Render):
#   VITE_API_BASE_URL=https://cropguard-pzs9.onrender.com
#
# Only VITE_-prefixed variables reach the browser bundle. Never put a secret here —
# anything VITE_ is public by definition.
VITE_API_BASE_URL=http://localhost:8000
