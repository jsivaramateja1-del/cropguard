{
  "name": "cropguard-frontend",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "CropGuard \u2014 mobile-first diagnosis app for crop disease screening",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test:errors": "node scripts/check-api-errors.mjs",
    "check": "npm run test:errors && npm run test:render && vite build",
    "test:render": "esbuild scripts/render-check.jsx --bundle --platform=node --format=cjs --jsx=automatic --loader:.jsx=jsx --loader:.css=empty --loader:.png=dataurl --outfile=node_modules/.cache/render-check.cjs --log-level=error && node node_modules/.cache/render-check.cjs",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test e2e/live-smoke.spec.js",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "audit": "pip-audit -r ../backend/requirements-deploy.txt --no-deps --disable-pip"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
