# CropGuard backend configuration
# Copy to .env and fill in. Never commit .env — it is gitignored.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave EMPTY to use local SQLite (backend/cropguard_local.db). That is the
# default for development and requires no setup at all.
#
# For Supabase, use the connection string from
#   Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# and swap the password placeholder for your database password. Session-pooler
# (port 5432) is the right choice for a long-running API; the transaction pooler
# (port 6543) suits serverless functions.
#
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ---------------------------------------------------------------------------
# Supabase (reserved — not used by the Phase 2 backend)
# ---------------------------------------------------------------------------
# The API talks to PostgreSQL through DATABASE_URL above. These two are for the
# browser client and for authenticated flows planned beyond the prototype.
# The service-role key is never used by this codebase and must never be shipped.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Image storage
# ---------------------------------------------------------------------------
# When all three Cloudinary values are set, uploaded leaf images go to
# Cloudinary. When any is missing, the backend falls back to local disk
# (backend/uploads/) and says so in the logs. Never commit these.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Account authentication
# ---------------------------------------------------------------------------
# Signing key for access tokens. If unset, a random key is generated per process, which
# signs everyone out on every restart. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Failed sign-in attempts allowed per email and per client before a temporary lockout.
LOGIN_MAX_FAILURES=8
LOGIN_FAILURE_WINDOW=900

# ---------------------------------------------------------------------------
# Email (Brevo) — password resets only
# ---------------------------------------------------------------------------
# Create an API key at https://app.brevo.com/settings/keys/api (free tier is fine).
# EMAIL_FROM must be a sender verified in Brevo, or the API returns 400.
# Unset means password reset is unavailable, and the API says so instead of pretending.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=CropGuard
# Minutes a reset link stays valid.
PASSWORD_RESET_MINUTES=30
# Base URL used to build links inside emails — the frontend, not the API.
PUBLIC_APP_URL=https://cropguard-blush.vercel.app

# ---------------------------------------------------------------------------
# Staff authentication
# ---------------------------------------------------------------------------
# Prototype-grade identity: one shared secret per role, sent as `Authorization: Bearer`.
# There is NO default, so an unconfigured deployment has no privileged access at all
# rather than a known default password.
#
#   EXPERT_TOKEN  required to review, confirm or correct a report
#   ADMIN_TOKEN   same powers, intended for operational use
#
# Generate strong values, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
EXPERT_TOKEN=
EXPERT_NAME=Agricultural expert
ADMIN_TOKEN=
ADMIN_NAME=Administrator

# Analyses allowed per client per window (costly operation).
ANALYZE_RATE_LIMIT=20
ANALYZE_RATE_WINDOW=60

# ---------------------------------------------------------------------------
# Weather (Open-Meteo)
# ---------------------------------------------------------------------------
# The free tier needs NO key and is limited to 10,000 calls/day, applied per IP.
# Open-Meteo's terms name cloud hosts (Render, Vercel, Netlify) as likely to be limited
# earlier than expected, so a deployment can receive HTTP 429 with no misuse involved.
# There is no free API key: OPEN_METEO_API_KEY exists only on a paid plan and moves
# requests to customer-api.open-meteo.com. The free mitigations are the per-location
# cache below and the keyless MET Norway fallback.
OPEN_METEO_API_KEY=
WEATHER_CACHE_TTL=600
WEATHER_TIMEOUT=8

# Which provider to try: auto = Open-Meteo first, then MET Norway as a fallback.
# Pin one with "open-meteo" or "met-no".
WEATHER_PROVIDER=auto

# MET Norway requires a User-Agent that identifies the application and a real contact.
# Use your own email here so their operators can reach you if your usage is unusual.
WEATHER_CONTACT=your-email@example.com

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# Path to the trained checkpoint. Relative paths resolve from the backend/
# directory. The matching class_names.json is read from the same folder.
MODEL_PATH=model/cropguard_mobilenetv3.pth

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
# Comma-separated list of allowed browser origins for CORS.
# Local Vite dev server plus the deployed frontend, e.g.:
#   FRONTEND_ORIGIN=http://localhost:5173,https://cropguard.vercel.app
#
# Vercel issues a NEW hostname for every deployment
# (project-<hash>-<team>.vercel.app), so whitelisting one exact URL breaks on the next
# deploy. Use the stable production domain, or a single-label wildcard:
#   FRONTEND_ORIGIN=http://localhost:5173,https://*.vercel.app
# The wildcard matches one host label only — https://a.b.vercel.app and
# https://vercel.app.evil.com do not match.
FRONTEND_ORIGIN=http://localhost:5173

# Optional extra regex for origins a wildcard cannot express.
FRONTEND_ORIGIN_REGEX=

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
